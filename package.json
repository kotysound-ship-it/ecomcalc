{
  "name": "ecom-calc",
  "productName": "EcomCalc AI",
  "version": "1.5.0",
  "description": "이커머스 운영 특화 AI 계산기",
  "main": "main.js",
  "author": "ProperMarket",
  "scripts": {
    "start": "electron .",
    "test": "node test/calc.test.js && node test/updater.test.js",
    "test:e2e": "node test/run-e2e.js",
    "dist": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags"
  },
  "build": {
    "appId": "kr.co.propermarket.ecomcalc",
    "productName": "EcomCalc AI",
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "CFBundleDisplayName": "이커머스 AI 계산기"
      }
    },
    "dmg": {
      "title": "이커머스 AI 계산기 ${version}"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "EcomCalc-AI-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "이커머스 AI 계산기",
      "uninstallDisplayName": "이커머스 AI 계산기",
      "artifactName": "EcomCalc-AI-Setup-${version}.${ext}",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kotysound-ship-it",
        "repo": "ecomcalc",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "exceljs": "^4.4.0",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "hyperformula": "^3.5.0"
  }
}
